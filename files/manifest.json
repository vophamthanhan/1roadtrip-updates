{
  "manifest_version": 3,
  "name": "1Roadtrip Extension",
  "version": "0.7.4",
  "description": "Privacy-focused sidebar with proxy fail-close, native consistency checks, deep per-origin protection, lockdown, and local audit.",
  "minimum_chrome_version": "125",
  "permissions": [
    "sidePanel",
    "storage",
    "debugger",
    "proxy",
    "privacy",
    "declarativeNetRequest",
    "webRequest",
    "webRequestAuthProvider"
  ],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open 1Roadtrip Extension",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": { "default_path": "sidepanel.html" },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "startup_lock",
        "enabled": true,
        "path": "rules/startup-lock.json"
      }
    ]
  }
}
